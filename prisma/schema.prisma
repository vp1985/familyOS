generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyUserRole {
  owner
  admin
  viewer
  child
}

enum FamilyMemberRole {
  parent
  child
  other
}

enum MoneyTransactionType {
  allowance
  loan
  repayment
  adjustment
  reward
  reversal
}

enum FinanceAccountKind {
  CASH
  GIRO
  SAVINGS
  DAY_MONEY
  HOME_SAVINGS
  OTHER
}

enum MoneyDirection {
  INCOME
  EXPENSE
}

enum MoneyInterval {
  MONTHLY
}

enum HouseholdBudgetDirection {
  INCOME
  EXPENSE
}

enum HouseholdBudgetKind {
  FIXED
  VARIABLE
  SAVING
  DEBT
  OTHER
}

enum MoneyOccurrenceStatus {
  OPEN
  PAID_CASH
  TRANSFERRED
  SAVED
  SKIPPED
}

enum ChildLedgerVisibility {
  PARENT_VISIBLE
  CHILD_PRIVATE
}

enum TaskStatus {
  open
  in_progress
  done
  confirmed
  skipped
  missed
}

enum TaskRecurrenceType {
  once
  daily
  weekly
  monthly
  weekdays
}

enum ProjectStatus {
  active
  done
  archived
}

enum ProjectExpenseStatus {
  active
  voided
}

enum ProjectSettlementStatus {
  open
  settled
}

enum RenovationProjectStatus {
  IDEA
  PLANNED
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

enum RenovationRoomStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  BLOCKED
  DONE
  ARCHIVED
}

enum RenovationTaskStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  BLOCKED
  DONE
  ARCHIVED
}

enum RenovationRoomShapeType {
  RECTANGLE
  L_SHAPE
  POLYGON
}

enum RenovationFloorPlanMarkerType {
  DOOR
  WINDOW
  SOCKET
  RADIATOR
  WATER
  DRAIN
  NOTE
  SLOPE_LINE
}

enum ConsequenceStatus {
  active
  done
  cancelled
}

enum MediaType {
  PHONE
  GAMING
  WATCHING
  TABLET
  APP
  OTHER
}

enum MediaRestrictionType {
  BLOCKED
  REDUCED
  PARENT_APPROVAL_REQUIRED
  CONVERTED_TO_EDUCATION
}

enum MediaRestrictionStatus {
  ACTIVE
  ENDED
  RELEASED
  CANCELLED
}

enum ChecklistKind {
  GENERAL
  PACKING
}

enum ChecklistStatus {
  OPEN
  DONE
  ARCHIVED
}

enum MealKind {
  BREAKFAST
  LUNCH
  DINNER
  UNSPECIFIED
}

enum RelationshipType {
  FRIEND
  FAMILY
  NEIGHBOR
  SCHOOL_CLUB
  OTHER
}

enum RelationshipPreferenceCategory {
  DRINK
  FOOD
  HOBBY
  GIFT_IDEA
  ALLERGY
  MEDICAL_NOTE
  OTHER
}

enum RelationshipPreferenceSentiment {
  LIKES
  DISLIKES
  NOTE
}

enum RelationshipGiftOccasion {
  BIRTHDAY
  CHRISTMAS
  EASTER
  SCHOOL
  OTHER
}

enum RelationshipGiftListVisibility {
  FAMILY_INTERNAL
  ORGANIZERS_ONLY
  HIDDEN_FROM_CHILDREN
}

enum RelationshipGiftStatus {
  IDEA
  WANTED
  RESERVED
  BOUGHT
  DONE
}

model User {
  id                              String                    @id @default(cuid())
  email                           String                    @unique
  name                            String
  passwordHash                    String
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  familyUsers                     FamilyUser[]
  sessions                        Session[]
  createdMoneyTransactions        MoneyTransaction[]
  createdHouseholdBudgetPlanItems HouseholdBudgetPlanItem[] @relation("HouseholdBudgetPlanItemCreatedBy")
  createdHouseholdBudgetEntries   HouseholdBudgetEntry[]    @relation("HouseholdBudgetEntryCreatedBy")
  createdMoneyRules               MoneyRule[]               @relation("MoneyRuleCreatedBy")
  confirmedMoneyOccurrences       MoneyOccurrence[]         @relation("MoneyOccurrenceConfirmedBy")
  createdChildLedgerEntries       ChildLedgerEntry[]        @relation("ChildLedgerEntryCreatedBy")
  createdProjects                 Project[]
  createdProjectExpenses          ProjectExpense[]
  createdProjectSettlements       ProjectSettlement[]
  createdProjectGuests            ProjectGuest[]            @relation("ProjectGuestCreatedBy")
  createdRenovationProjects       RenovationProject[]
  createdRenovationWorkPackages   RenovationWorkPackage[]
  createdRenovationTasks          RenovationTask[]
  createdRules                    Rule[]
  createdRuleEvents               RuleEvent[]
  createdConsequences             Consequence[]
  createdPointTransactions        PointTransaction[]
  createdXpTransactions           XpTransaction[]
  createdRewards                  Reward[]
  createdRewardRedemptions        RewardRedemption[]
  createdBadgeAssignments         BadgeAssignment[]
  createdCalendarEvents           CalendarEvent[]
  createdCalendarSources          CalendarSource[]
  createdTaskTemplates            TaskTemplate[]            @relation("TaskTemplateCreatedBy")
  confirmedTaskOccurrences        TaskOccurrence[]          @relation("TaskOccurrenceConfirmedBy")
  createdMediaAllowanceRules      MediaAllowanceRule[]      @relation("MediaAllowanceRuleCreatedBy")
  createdMediaRestrictions        MediaRestriction[]        @relation("MediaRestrictionCreatedBy")
  releasedMediaRestrictions       MediaRestriction[]        @relation("MediaRestrictionReleasedBy")
  createdCompetitionPlayers       CompetitionPlayer[]       @relation("CompetitionPlayerCreatedBy")
  createdChecklistTemplates       ChecklistTemplate[]       @relation("ChecklistTemplateCreatedBy")
  createdChecklistInstances       ChecklistInstance[]       @relation("ChecklistInstanceCreatedBy")
  checkedChecklistItems           ChecklistItemInstance[]   @relation("ChecklistItemCheckedBy")
  createdMealPlanEntries          MealPlanEntry[]           @relation("MealPlanEntryCreatedBy")
  createdRelationshipContacts     RelationshipContact[]     @relation("RelationshipContactCreatedBy")
  createdRelationshipGiftIdeas    RelationshipGiftIdea[]    @relation("RelationshipGiftIdeaCreatedBy")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Family {
  id                         String                    @id @default(cuid())
  name                       String
  loginSlug                  String?                   @unique
  showPositiveBadgesToFamily Boolean                   @default(false)
  renovationModuleEnabled    Boolean                   @default(false)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  users                      FamilyUser[]
  members                    FamilyMember[]
  financeAccounts            FinanceAccount[]
  householdBudgetPlanItems   HouseholdBudgetPlanItem[]
  householdBudgetEntries     HouseholdBudgetEntry[]
  moneyTransactions          MoneyTransaction[]
  moneyRules                 MoneyRule[]
  moneyOccurrences           MoneyOccurrence[]
  childLedgerEntries         ChildLedgerEntry[]
  projects                   Project[]
  projectExpenses            ProjectExpense[]
  projectSettlements         ProjectSettlement[]
  projectGuests              ProjectGuest[]
  renovationProjects         RenovationProject[]
  renovationRooms            RenovationRoom[]
  renovationWorkPackages     RenovationWorkPackage[]
  renovationTasks            RenovationTask[]
  rules                      Rule[]
  ruleEvents                 RuleEvent[]
  consequences               Consequence[]
  pointTransactions          PointTransaction[]
  xpTransactions             XpTransaction[]
  rewards                    Reward[]
  rewardRedemptions          RewardRedemption[]
  badgeAssignments           BadgeAssignment[]
  calendarEvents             CalendarEvent[]
  calendarSources            CalendarSource[]
  taskTemplates              TaskTemplate[]
  taskOccurrences            TaskOccurrence[]
  mediaAllowanceRules        MediaAllowanceRule[]
  mediaRestrictions          MediaRestriction[]
  competitionPlayers         CompetitionPlayer[]
  checklistTemplates         ChecklistTemplate[]
  checklistInstances         ChecklistInstance[]
  mealPlanEntries            MealPlanEntry[]
  relationshipContacts       RelationshipContact[]
  relationshipPreferences    RelationshipPreference[]
  relationshipGiftLists      RelationshipGiftList[]
  relationshipGiftIdeas      RelationshipGiftIdea[]
}

model FamilyUser {
  id                  String         @id @default(cuid())
  familyId            String
  userId              String
  role                FamilyUserRole @default(viewer)
  familyMemberId      String?
  childLoginName      String?
  childAccountEnabled Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  family Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  member FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@unique([familyId, childLoginName])
  @@index([userId])
  @@index([familyId])
  @@index([familyMemberId])
}

model FamilyMember {
  id                         String           @id @default(cuid())
  familyId                   String
  name                       String
  role                       FamilyMemberRole
  color                      String?
  icon                       String?
  birthday                   DateTime?
  childCanCreateCashAccounts Boolean          @default(true)
  childCashAccountLimit      Int              @default(5)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  family                 Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userAccounts           FamilyUser[]
  financeAccounts        FinanceAccount[]
  moneyTransactions      MoneyTransaction[]
  moneyRules             MoneyRule[]           @relation("MoneyRuleChild")
  moneyOccurrences       MoneyOccurrence[]     @relation("MoneyOccurrenceChild")
  childLedgerEntries     ChildLedgerEntry[]    @relation("ChildLedgerEntryChild")
  createdLedgerEntries   ChildLedgerEntry[]    @relation("ChildLedgerEntryCreatedByChild")
  projectParticipants    ProjectParticipant[]
  paidProjectExpenses    ProjectExpense[]      @relation("ProjectExpensePayer")
  projectExpenseShares   ProjectExpenseShare[]
  projectSettlementsTo   ProjectSettlement[]   @relation("ProjectSettlementReceiver")
  projectSettlementsFrom ProjectSettlement[]   @relation("ProjectSettlementPayer")
  ruleEvents             RuleEvent[]
  consequences           Consequence[]
  pointTransactions      PointTransaction[]
  xpTransactions         XpTransaction[]
  rewardRedemptions      RewardRedemption[]
  badgeAssignments       BadgeAssignment[]
  calendarEvents         CalendarEvent[]
  calendarSources        CalendarSource[]
  taskAssignments        TaskAssignment[]
  taskOccurrences        TaskOccurrence[]
  mediaAllowanceRules    MediaAllowanceRule[]  @relation("MediaAllowanceRuleChild")
  mediaRestrictions      MediaRestriction[]    @relation("MediaRestrictionChild")
  assignedChecklists     ChecklistInstance[]   @relation("ChecklistAssignedMember")
  mealPlanEntries        MealPlanEntry[]
  relationshipContacts   RelationshipContact[] @relation("RelationshipContactRelatedMember")

  @@index([familyId])
}

model MealPlanEntry {
  id                 String   @id @default(cuid())
  familyId           String
  familyMemberId     String?
  dishName           String
  plannedDate        DateTime
  mealKind           MealKind @default(UNSPECIFIED)
  note               String?
  sourceApp          String   @default("familyos")
  visibleInNutrition Boolean  @default(true)
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  createdBy User          @relation("MealPlanEntryCreatedBy", fields: [createdByUserId], references: [id])

  @@index([familyId, plannedDate])
  @@index([familyMemberId, plannedDate])
  @@index([createdByUserId])
  @@index([visibleInNutrition])
}

model RelationshipContact {
  id                    String           @id @default(cuid())
  familyId              String
  name                  String
  relationshipType      RelationshipType @default(FRIEND)
  relatedFamilyMemberId String?
  notes                 String?
  createdByUserId       String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  family              Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  relatedFamilyMember FamilyMember?            @relation("RelationshipContactRelatedMember", fields: [relatedFamilyMemberId], references: [id], onDelete: SetNull)
  createdBy           User                     @relation("RelationshipContactCreatedBy", fields: [createdByUserId], references: [id])
  preferences         RelationshipPreference[]
  giftLists           RelationshipGiftList[]
  projectGuests       ProjectGuest[]

  @@index([familyId, name])
  @@index([relatedFamilyMemberId])
  @@index([createdByUserId])
}

model RelationshipPreference {
  id         String                          @id @default(cuid())
  familyId   String
  contactId  String
  category   RelationshipPreferenceCategory
  label      String
  sentiment  RelationshipPreferenceSentiment @default(NOTE)
  isFavorite Boolean                         @default(false)
  notes      String?
  createdAt  DateTime                        @default(now())
  updatedAt  DateTime                        @updatedAt

  family  Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contact RelationshipContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([familyId, category])
  @@index([contactId])
}

model RelationshipGiftList {
  id         String                         @id @default(cuid())
  familyId   String
  contactId  String
  title      String
  occasion   RelationshipGiftOccasion       @default(OTHER)
  eventDate  DateTime?
  visibility RelationshipGiftListVisibility @default(FAMILY_INTERNAL)
  notes      String?
  createdAt  DateTime                       @default(now())
  updatedAt  DateTime                       @updatedAt

  family    Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contact   RelationshipContact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  giftIdeas RelationshipGiftIdea[]

  @@index([familyId, occasion])
  @@index([contactId])
}

model RelationshipGiftIdea {
  id                  String                 @id @default(cuid())
  familyId            String
  giftListId          String
  title               String
  url                 String?
  estimatedPriceCents Int?
  priority            Int                    @default(3)
  status              RelationshipGiftStatus @default(IDEA)
  notes               String?
  createdByUserId     String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  family    Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  giftList  RelationshipGiftList @relation(fields: [giftListId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("RelationshipGiftIdeaCreatedBy", fields: [createdByUserId], references: [id])

  @@index([familyId, status])
  @@index([giftListId])
  @@index([createdByUserId])
}

model HouseholdBudgetPlanItem {
  id              String                   @id @default(cuid())
  familyId        String
  title           String
  category        String
  amountCents     Int
  direction       HouseholdBudgetDirection
  kind            HouseholdBudgetKind      @default(VARIABLE)
  active          Boolean                  @default(true)
  createdByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  family    Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User                   @relation("HouseholdBudgetPlanItemCreatedBy", fields: [createdByUserId], references: [id])
  entries   HouseholdBudgetEntry[]

  @@index([familyId, active])
  @@index([createdByUserId])
}

model HouseholdBudgetEntry {
  id              String                   @id @default(cuid())
  familyId        String
  planItemId      String?
  title           String
  category        String
  amountCents     Int
  direction       HouseholdBudgetDirection
  monthKey        String
  occurredAt      DateTime                 @default(now())
  createdByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  family    Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  planItem  HouseholdBudgetPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  createdBy User                     @relation("HouseholdBudgetEntryCreatedBy", fields: [createdByUserId], references: [id])

  @@index([familyId, monthKey])
  @@index([planItemId])
  @@index([createdByUserId])
}

model FinanceAccount {
  id             String             @id @default(cuid())
  familyId       String
  familyMemberId String
  name           String             @default("Kinderkonto")
  kind           FinanceAccountKind @default(CASH)
  isDefault      Boolean            @default(false)
  childManaged   Boolean            @default(false)
  childCanBook   Boolean            @default(false)
  balanceCents   Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  family        Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member        FamilyMember       @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  transactions  MoneyTransaction[]
  moneyRules    MoneyRule[]
  ledgerEntries ChildLedgerEntry[]

  @@index([familyId])
  @@index([familyMemberId])
}

model MoneyTransaction {
  id                String               @id @default(cuid())
  familyId          String
  familyMemberId    String
  financeAccountId  String?
  type              MoneyTransactionType
  title             String
  amountCents           Int
  balanceAfterCents     Int
  createdByUserId       String
  reversalTransactionId String?              @unique
  createdAt             DateTime             @default(now())

  family              Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member              FamilyMember      @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  account             FinanceAccount?   @relation(fields: [financeAccountId], references: [id], onDelete: SetNull)
  bookedOccurrences   MoneyOccurrence[] @relation("MoneyOccurrenceBookedTransaction")
  createdBy           User              @relation(fields: [createdByUserId], references: [id])
  reversalTransaction MoneyTransaction? @relation("MoneyTransactionReversal", fields: [reversalTransactionId], references: [id])
  reversedTransaction MoneyTransaction? @relation("MoneyTransactionReversal")

  @@index([familyId, createdAt])
  @@index([familyMemberId, createdAt])
  @@index([financeAccountId, createdAt])
}

model MoneyRule {
  id               String         @id @default(cuid())
  familyId         String
  childId          String
  financeAccountId String?
  title            String
  amountCents      Int
  direction        MoneyDirection
  interval         MoneyInterval  @default(MONTHLY)
  destinationLabel String?
  autoConfirm      Boolean        @default(false)
  visibleToChild   Boolean        @default(true)
  active           Boolean        @default(true)
  createdByUserId  String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child       FamilyMember      @relation("MoneyRuleChild", fields: [childId], references: [id], onDelete: Cascade)
  account     FinanceAccount?   @relation(fields: [financeAccountId], references: [id], onDelete: SetNull)
  createdBy   User              @relation("MoneyRuleCreatedBy", fields: [createdByUserId], references: [id])
  occurrences MoneyOccurrence[]

  @@index([familyId, active])
  @@index([childId, active])
  @@index([financeAccountId])
  @@index([createdByUserId])
}

model MoneyOccurrence {
  id                       String                @id @default(cuid())
  familyId                 String
  ruleId                   String
  childId                  String
  financeAccountIdSnapshot String?
  dueMonth                 String
  amountCentsSnapshot      Int
  titleSnapshot            String
  destinationSnapshot      String?
  autoConfirmSnapshot      Boolean               @default(false)
  status                   MoneyOccurrenceStatus @default(OPEN)
  bookedTransactionId      String?
  confirmedByParentId      String?
  confirmedAt              DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  family            Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  rule              MoneyRule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  child             FamilyMember      @relation("MoneyOccurrenceChild", fields: [childId], references: [id], onDelete: Cascade)
  bookedTransaction MoneyTransaction? @relation("MoneyOccurrenceBookedTransaction", fields: [bookedTransactionId], references: [id], onDelete: SetNull)
  confirmedBy       User?             @relation("MoneyOccurrenceConfirmedBy", fields: [confirmedByParentId], references: [id])

  @@unique([ruleId, dueMonth])
  @@index([familyId, dueMonth])
  @@index([childId, dueMonth])
  @@index([bookedTransactionId])
  @@index([status])
}

model ChildLedgerEntry {
  id               String                @id @default(cuid())
  familyId         String
  childId          String
  financeAccountId String?
  amountCents      Int
  direction        MoneyDirection
  title            String
  note             String?
  categoryLabel    String?
  visibility       ChildLedgerVisibility @default(PARENT_VISIBLE)
  createdByUserId  String?
  createdByChildId String
  occurredAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  family         Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child          FamilyMember    @relation("ChildLedgerEntryChild", fields: [childId], references: [id], onDelete: Cascade)
  account        FinanceAccount? @relation(fields: [financeAccountId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("ChildLedgerEntryCreatedBy", fields: [createdByUserId], references: [id])
  createdByChild FamilyMember    @relation("ChildLedgerEntryCreatedByChild", fields: [createdByChildId], references: [id], onDelete: Cascade)

  @@index([familyId, occurredAt])
  @@index([childId, occurredAt])
  @@index([financeAccountId, occurredAt])
  @@index([visibility])
  @@index([createdByUserId])
  @@index([createdByChildId])
}

model Project {
  id              String        @id @default(cuid())
  familyId        String
  title           String
  description     String?
  status          ProjectStatus @default(active)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  family             Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy          User                 @relation(fields: [createdByUserId], references: [id])
  participants       ProjectParticipant[]
  relationshipGuests ProjectGuest[]
  expenses           ProjectExpense[]
  renovationProjects RenovationProject[]
  settlements        ProjectSettlement[]

  @@index([familyId, createdAt])
  @@index([createdByUserId])
}

model ProjectParticipant {
  id             String   @id @default(cuid())
  projectId      String
  familyMemberId String
  createdAt      DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([projectId, familyMemberId])
  @@index([familyMemberId])
}

model ProjectGuest {
  id              String   @id @default(cuid())
  familyId        String
  projectId       String
  contactId       String
  createdByUserId String
  createdAt       DateTime @default(now())

  family    Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact   RelationshipContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy User                @relation("ProjectGuestCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([projectId, contactId])
  @@index([familyId, projectId])
  @@index([contactId])
  @@index([createdByUserId])
}

model ProjectExpense {
  id              String               @id @default(cuid())
  familyId        String
  projectId       String
  title           String
  description     String?
  amountCents     Int
  paidByMemberId  String
  createdByUserId String
  expenseDate     DateTime             @default(now())
  status          ProjectExpenseStatus @default(active)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  family       Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paidByMember FamilyMember          @relation("ProjectExpensePayer", fields: [paidByMemberId], references: [id])
  createdBy    User                  @relation(fields: [createdByUserId], references: [id])
  shares       ProjectExpenseShare[]

  @@index([familyId, createdAt])
  @@index([projectId, expenseDate])
  @@index([paidByMemberId])
}

model ProjectExpenseShare {
  id             String   @id @default(cuid())
  expenseId      String
  familyMemberId String
  shareCents     Int
  createdAt      DateTime @default(now())

  expense ProjectExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  FamilyMember   @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, familyMemberId])
  @@index([familyMemberId])
}

model RenovationProject {
  id              String                  @id @default(cuid())
  familyId        String
  title           String
  description     String?
  status          RenovationProjectStatus @default(IDEA)
  priority        Int                     @default(3)
  startDate       DateTime?
  targetDate      DateTime?
  budgetCents     Int?
  linkedProjectId String?
  createdByUserId String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  family        Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  linkedProject Project?                @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)
  createdBy     User                    @relation(fields: [createdByUserId], references: [id])
  rooms         RenovationRoom[]
  workPackages  RenovationWorkPackage[]
  tasks         RenovationTask[]

  @@index([familyId, status])
  @@index([linkedProjectId])
  @@index([createdByUserId])
}

model RenovationRoom {
  id                  String               @id @default(cuid())
  familyId            String
  renovationProjectId String
  name                String
  category            String               @default("Raum")
  floorLabel          String?
  description         String?
  status              RenovationRoomStatus @default(OPEN)
  lengthMm            Int?
  widthMm             Int?
  heightMm            Int?
  floorAreaM2Override Float?
  wallAreaM2Override  Float?
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  family            Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  renovationProject RenovationProject       @relation(fields: [renovationProjectId], references: [id], onDelete: Cascade)
  floorPlan         RenovationFloorPlan?
  workPackages      RenovationWorkPackage[]
  tasks             RenovationTask[]

  @@index([familyId, renovationProjectId, sortOrder])
  @@index([renovationProjectId])
}

model RenovationWorkPackage {
  id                  String               @id @default(cuid())
  familyId            String
  renovationProjectId String
  roomId              String?
  title               String
  description         String?
  status              RenovationTaskStatus @default(OPEN)
  sortOrder           Int                  @default(0)
  createdByUserId     String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  family            Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  renovationProject RenovationProject @relation(fields: [renovationProjectId], references: [id], onDelete: Cascade)
  room              RenovationRoom?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy         User              @relation(fields: [createdByUserId], references: [id])
  tasks             RenovationTask[]

  @@index([familyId, renovationProjectId, status])
  @@index([roomId])
  @@index([createdByUserId])
}

model RenovationTask {
  id                  String               @id @default(cuid())
  familyId            String
  renovationProjectId String
  roomId              String?
  workPackageId       String?
  title               String
  description         String?
  status              RenovationTaskStatus @default(OPEN)
  blockerNote         String?
  dueDate             DateTime?
  sortOrder           Int                  @default(0)
  createdByUserId     String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  family            Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  renovationProject RenovationProject      @relation(fields: [renovationProjectId], references: [id], onDelete: Cascade)
  room              RenovationRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  workPackage       RenovationWorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  createdBy         User                   @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, renovationProjectId, status])
  @@index([roomId])
  @@index([workPackageId])
  @@index([createdByUserId])
}

model RenovationFloorPlan {
  id                      String                  @id @default(cuid())
  roomId                  String                  @unique
  shapeType               RenovationRoomShapeType @default(RECTANGLE)
  pointsJson              String?
  scaleJson               String?
  backgroundDocumentId    String?
  backgroundTransformJson String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  room    RenovationRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  markers RenovationFloorPlanMarker[]
}

model RenovationFloorPlanMarker {
  id          String                        @id @default(cuid())
  floorPlanId String
  type        RenovationFloorPlanMarkerType
  label       String
  wall        String?
  xM          Float?
  yM          Float?
  widthM      Float?
  note        String?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  floorPlan RenovationFloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([floorPlanId, type])
}

model ProjectSettlement {
  id              String                  @id @default(cuid())
  familyId        String
  projectId       String
  fromMemberId    String
  toMemberId      String
  amountCents     Int
  status          ProjectSettlementStatus @default(open)
  createdByUserId String
  settledAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromMember FamilyMember @relation("ProjectSettlementPayer", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   FamilyMember @relation("ProjectSettlementReceiver", fields: [toMemberId], references: [id], onDelete: Cascade)
  createdBy  User         @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, projectId, status])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model Rule {
  id              String   @id @default(cuid())
  familyId        String
  title           String
  description     String?
  category        String
  isActive        Boolean  @default(true)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family    Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User        @relation(fields: [createdByUserId], references: [id])
  events    RuleEvent[]

  @@index([familyId, isActive])
  @@index([createdByUserId])
}

model RuleEvent {
  id              String   @id @default(cuid())
  familyId        String
  ruleId          String
  familyMemberId  String
  note            String
  occurredAt      DateTime @default(now())
  createdByUserId String
  createdAt       DateTime @default(now())

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  rule              Rule               @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  member            FamilyMember       @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  createdBy         User               @relation(fields: [createdByUserId], references: [id])
  consequences      Consequence[]
  mediaRestrictions MediaRestriction[]

  @@index([familyId, occurredAt])
  @@index([ruleId, occurredAt])
  @@index([familyMemberId, occurredAt])
}

model Consequence {
  id              String            @id @default(cuid())
  familyId        String
  familyMemberId  String
  ruleEventId     String?
  title           String
  description     String?
  status          ConsequenceStatus @default(active)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  ruleEvent RuleEvent?   @relation(fields: [ruleEventId], references: [id], onDelete: SetNull)
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, status])
  @@index([familyMemberId, status])
  @@index([ruleEventId])
  @@index([createdByUserId])
}

model MediaAllowanceRule {
  id              String    @id @default(cuid())
  familyId        String
  childId         String?
  mediaType       MediaType
  minAgeYears     Int?
  minutesPerDay   Int?
  minutesPerWeek  Int?
  daysOfWeekJson  String?
  note            String?
  active          Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child     FamilyMember? @relation("MediaAllowanceRuleChild", fields: [childId], references: [id], onDelete: Cascade)
  createdBy User          @relation("MediaAllowanceRuleCreatedBy", fields: [createdByUserId], references: [id])

  @@index([familyId, active])
  @@index([childId, active])
  @@index([mediaType, minAgeYears])
  @@index([createdByUserId])
}

model MediaRestriction {
  id                          String                 @id @default(cuid())
  familyId                    String
  childId                     String
  mediaType                   MediaType
  appOrDeviceLabel            String?
  restrictionType             MediaRestrictionType
  reducedMinutes              Int?
  convertedToEducationMinutes Int?
  educationCategoryKey        String?
  linkedTaskOccurrenceId      String?
  childVisibleReasonLabel     String?
  startsAt                    DateTime
  endsAt                      DateTime
  status                      MediaRestrictionStatus @default(ACTIVE)
  reasonNote                  String?
  ruleEventId                 String?
  remindAt                    DateTime?
  releasedAt                  DateTime?
  releasedByUserId            String?
  createdByUserId             String
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  family               Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child                FamilyMember    @relation("MediaRestrictionChild", fields: [childId], references: [id], onDelete: Cascade)
  linkedTaskOccurrence TaskOccurrence? @relation("MediaRestrictionLinkedTaskOccurrence", fields: [linkedTaskOccurrenceId], references: [id], onDelete: SetNull)
  ruleEvent            RuleEvent?      @relation(fields: [ruleEventId], references: [id], onDelete: SetNull)
  createdBy            User            @relation("MediaRestrictionCreatedBy", fields: [createdByUserId], references: [id])
  releasedBy           User?           @relation("MediaRestrictionReleasedBy", fields: [releasedByUserId], references: [id])

  @@index([familyId, status])
  @@index([childId, status])
  @@index([linkedTaskOccurrenceId])
  @@index([ruleEventId])
  @@index([endsAt])
  @@index([createdByUserId])
  @@index([releasedByUserId])
}

model CompetitionPlayer {
  id              String   @id @default(cuid())
  familyId        String
  name            String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("CompetitionPlayerCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([familyId, name])
  @@index([familyId, name])
  @@index([createdByUserId])
}

model PointTransaction {
  id              String   @id @default(cuid())
  familyId        String
  familyMemberId  String
  points          Int
  reason          String
  createdByUserId String
  createdAt       DateTime @default(now())

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, createdAt])
  @@index([familyMemberId, createdAt])
  @@index([createdByUserId])
}

model XpTransaction {
  id              String   @id @default(cuid())
  familyId        String
  familyMemberId  String
  xp              Int
  reason          String
  createdByUserId String
  createdAt       DateTime @default(now())

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, createdAt])
  @@index([familyMemberId, createdAt])
  @@index([createdByUserId])
}

model Reward {
  id              String   @id @default(cuid())
  familyId        String
  title           String
  description     String?
  costPoints      Int
  isActive        Boolean  @default(true)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation(fields: [createdByUserId], references: [id])
  redemptions RewardRedemption[]

  @@index([familyId, isActive])
  @@index([createdByUserId])
}

model RewardRedemption {
  id              String   @id @default(cuid())
  familyId        String
  rewardId        String
  familyMemberId  String
  costPoints      Int
  createdByUserId String
  createdAt       DateTime @default(now())

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  reward    Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, createdAt])
  @@index([rewardId])
  @@index([familyMemberId, createdAt])
  @@index([createdByUserId])
}

model BadgeAssignment {
  id              String   @id @default(cuid())
  familyId        String
  familyMemberId  String
  title           String
  icon            String   @default("🏅")
  description     String?
  isPositive      Boolean  @default(true)
  visibleToFamily Boolean  @default(false)
  createdByUserId String
  createdAt       DateTime @default(now())

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, createdAt])
  @@index([familyMemberId, createdAt])
  @@index([createdByUserId])
}

model TaskTemplate {
  id                   String             @id @default(cuid())
  familyId             String
  title                String
  description          String?
  category             String
  priority             String             @default("medium")
  requiresConfirmation Boolean            @default(true)
  recurrenceType       TaskRecurrenceType @default(once)
  weekdays             Int[]              @default([])
  startsAt             DateTime?
  endsAt               DateTime?
  dueTime              String?
  drachmenReward       Int?
  xpReward             Int?
  moneyRewardCents     Int?
  badgeRewardTitle     String?
  badgeRewardIcon      String?
  isActive             Boolean            @default(true)
  createdByUserId      String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  family             Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("TaskTemplateCreatedBy", fields: [createdByUserId], references: [id])
  assignments        TaskAssignment[]
  subtasks           TaskSubTask[]
  occurrences        TaskOccurrence[]
  checklistInstances ChecklistInstance[]

  @@index([familyId, isActive])
  @@index([createdByUserId])
}

model TaskAssignment {
  id             String   @id @default(cuid())
  taskTemplateId String
  familyMemberId String
  createdAt      DateTime @default(now())

  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  member       FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([taskTemplateId, familyMemberId])
  @@index([familyMemberId])
}

model TaskSubTask {
  id             String   @id @default(cuid())
  taskTemplateId String
  title          String
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)

  @@index([taskTemplateId, position])
}

model TaskOccurrence {
  id                   String     @id @default(cuid())
  familyId             String
  taskTemplateId       String
  familyMemberId       String
  titleSnapshot        String
  dueAt                DateTime?
  status               TaskStatus @default(open)
  requiresConfirmation Boolean    @default(true)
  doneAt               DateTime?
  confirmedAt          DateTime?
  confirmedByUserId    String?
  drachmenReward       Int?
  xpReward             Int?
  moneyRewardCents     Int?
  badgeRewardTitle     String?
  badgeRewardIcon      String?
  rewardBookedAt       DateTime?
  note                 String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  family                  Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  taskTemplate            TaskTemplate            @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  member                  FamilyMember            @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  confirmedBy             User?                   @relation("TaskOccurrenceConfirmedBy", fields: [confirmedByUserId], references: [id])
  subtasks                TaskOccurrenceSubTask[]
  checklistInstances      ChecklistInstance[]
  linkedMediaRestrictions MediaRestriction[]      @relation("MediaRestrictionLinkedTaskOccurrence")

  @@index([familyId, dueAt])
  @@index([familyMemberId, dueAt])
  @@index([taskTemplateId])
  @@index([status])
}

model TaskOccurrenceSubTask {
  id               String    @id @default(cuid())
  taskOccurrenceId String
  titleSnapshot    String
  position         Int       @default(0)
  completedAt      DateTime?

  occurrence TaskOccurrence @relation(fields: [taskOccurrenceId], references: [id], onDelete: Cascade)

  @@index([taskOccurrenceId, position])
}

model ChecklistTemplate {
  id              String        @id @default(cuid())
  familyId        String
  title           String
  description     String?
  category        String        @default("Alltag")
  kind            ChecklistKind @default(GENERAL)
  active          Boolean       @default(true)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  family    Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User                    @relation("ChecklistTemplateCreatedBy", fields: [createdByUserId], references: [id])
  items     ChecklistTemplateItem[]
  instances ChecklistInstance[]

  @@index([familyId, active])
  @@index([createdByUserId])
}

model ChecklistTemplateItem {
  id            String   @id @default(cuid())
  templateId    String
  title         String
  note          String?
  quantityLabel String?
  required      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model ChecklistInstance {
  id                     String          @id @default(cuid())
  familyId               String
  templateId             String?
  taskTemplateId         String?
  taskOccurrenceId       String?
  assignedFamilyMemberId String?
  titleSnapshot          String
  categorySnapshot       String          @default("Alltag")
  kindSnapshot           ChecklistKind   @default(GENERAL)
  status                 ChecklistStatus @default(OPEN)
  createdByUserId        String
  completedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  family         Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  template       ChecklistTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  taskTemplate   TaskTemplate?           @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)
  taskOccurrence TaskOccurrence?         @relation(fields: [taskOccurrenceId], references: [id], onDelete: SetNull)
  assignedMember FamilyMember?           @relation("ChecklistAssignedMember", fields: [assignedFamilyMemberId], references: [id], onDelete: SetNull)
  createdBy      User                    @relation("ChecklistInstanceCreatedBy", fields: [createdByUserId], references: [id])
  items          ChecklistItemInstance[]

  @@index([familyId, status])
  @@index([taskOccurrenceId])
  @@index([assignedFamilyMemberId, status])
  @@index([createdByUserId])
}

model ChecklistItemInstance {
  id                    String    @id @default(cuid())
  checklistInstanceId   String
  titleSnapshot         String
  noteSnapshot          String?
  quantityLabelSnapshot String?
  requiredSnapshot      Boolean   @default(true)
  sortOrder             Int       @default(0)
  checked               Boolean   @default(false)
  checkedByUserId       String?
  checkedAt             DateTime?

  checklistInstance ChecklistInstance @relation(fields: [checklistInstanceId], references: [id], onDelete: Cascade)
  checkedBy         User?             @relation("ChecklistItemCheckedBy", fields: [checkedByUserId], references: [id])

  @@index([checklistInstanceId, sortOrder])
  @@index([checkedByUserId])
}

model CalendarEvent {
  id              String    @id @default(cuid())
  familyId        String
  familyMemberId  String?
  sourceId        String?
  externalEventId String?
  title           String
  description     String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime?
  allDay          Boolean   @default(false)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  family    Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember?   @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  source    CalendarSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdByUserId], references: [id])

  @@unique([sourceId, externalEventId])
  @@index([familyId, startsAt])
  @@index([familyMemberId, startsAt])
  @@index([sourceId])
  @@index([createdByUserId])
}

model CalendarSource {
  id              String    @id @default(cuid())
  familyId        String
  familyMemberId  String?
  provider        String    @default("google_ical")
  name            String
  url             String
  syncEnabled     Boolean   @default(true)
  lastSyncedAt    DateTime?
  lastSyncError   String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  family    Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember?   @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  createdBy User            @relation(fields: [createdByUserId], references: [id])
  events    CalendarEvent[]

  @@index([familyId, syncEnabled])
  @@index([familyMemberId])
  @@index([createdByUserId])
}
