generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyUserRole {
  owner
  admin
  viewer
}

enum FamilyMemberRole {
  parent
  child
  other
}

enum MoneyTransactionType {
  allowance
  loan
  repayment
  adjustment
}

model User {
  id                       String             @id @default(cuid())
  email                    String             @unique
  name                     String
  passwordHash             String
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  familyUsers              FamilyUser[]
  sessions                 Session[]
  createdMoneyTransactions MoneyTransaction[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Family {
  id                String             @id @default(cuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             FamilyUser[]
  members           FamilyMember[]
  financeAccounts   FinanceAccount[]
  moneyTransactions MoneyTransaction[]
}

model FamilyUser {
  id        String         @id @default(cuid())
  familyId  String
  userId    String
  role      FamilyUserRole @default(viewer)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@index([familyId])
}

model FamilyMember {
  id                String             @id @default(cuid())
  familyId          String
  name              String
  role              FamilyMemberRole
  color             String?
  icon              String?
  birthday          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  financeAccount    FinanceAccount?
  moneyTransactions MoneyTransaction[]

  @@index([familyId])
}

model FinanceAccount {
  id             String   @id @default(cuid())
  familyId       String
  familyMemberId String   @unique
  balanceCents   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model MoneyTransaction {
  id                String               @id @default(cuid())
  familyId          String
  familyMemberId    String
  type              MoneyTransactionType
  title             String
  amountCents       Int
  balanceAfterCents Int
  createdByUserId   String
  createdAt         DateTime             @default(now())

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, createdAt])
  @@index([familyMemberId, createdAt])
}
